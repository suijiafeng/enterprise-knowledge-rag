# Local infrastructure only. Copy to .env, choose fresh values. Never commit .env.
POSTGRES_DB=zhiku
POSTGRES_USER=zhiku_local
POSTGRES_PASSWORD=
# HS256 key for locally issued dev tokens, at least 32 random bytes, e.g. `openssl rand -base64 48`.
ZHIKU_JWT_SECRET=
# Local models via Ollama (no paid API, data stays on this machine). Leave as none to disable.
# Use mock for both providers to run without any model (built-in bigram embedding + extractive answers; local/CI only).
ZHIKU_EMBEDDING_PROVIDER=none
ZHIKU_EMBEDDING_MODEL=bge-m3
ZHIKU_CHAT_PROVIDER=none
ZHIKU_CHAT_MODEL=qwen3.5:latest
ZHIKU_OLLAMA_URL=http://127.0.0.1:11434
# Relevance gate: a source counts only if cosine >= MIN_SCORE or question-bigram coverage >= MIN_LEXICAL.
# Calibrate per embedding model with the eval set; for the mock embedding 0.3 works.
ZHIKU_RETRIEVAL_MIN_SCORE=0.45
ZHIKU_RETRIEVAL_MIN_LEXICAL=0.35
# Follow-up rewriting before retrieval: llm (falls back to heuristic) | heuristic | off.
ZHIKU_QUERY_REWRITE=llm
# Comma-separated widget host origins allowed to call /api/chat from a browser; empty disables CORS.
ZHIKU_WIDGET_ORIGINS=
# Admin dev server proxies /api to this origin. Keep it aligned with server.port (default 8080).
ZHIKU_DEV_PROXY=http://127.0.0.1:8080
# Start the server with SPRING_PROFILES_ACTIVE=dev for local work: it seeds demo accounts (admin / operator / employee)
# and accepts scripts/dev-token.mjs tokens. Optional: their password (dev profile only, default zhiku-demo-2026).
# ZHIKU_DEMO_PASSWORD=
# Publish needs a separate approve step when true. Default false: publishing also approves (one-step upload and publish).
# ZHIKU_REQUIRE_APPROVAL=false
# Rate limit counters: memory (single instance, default) | postgres (shared by all instances).
# ZHIKU_RATE_LIMIT_STORE=memory
# docker compose only: host ports (bound to 127.0.0.1) and the models used inside the containers (mock by default).
# ZHIKU_WEB_PORT=5180
# ZHIKU_SERVER_PORT=8080
# POSTGRES_PORT=5432
# ZHIKU_COMPOSE_EMBEDDING_PROVIDER=mock
# ZHIKU_COMPOSE_CHAT_PROVIDER=mock
